---
import "../styles/global.css";

---

<!-- TECHNICAL SKILLS -->
  <section class="mb-2.5 print:mb-2 print-break-inside-avoid">
    <h2
      class="text-[11px] uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200 pb-0.5 mb-1.5"
    >
      Technical Skills
    </h2>
    <div class="space-y-0.5 text-[11px] leading-tight">
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
        <span class="sm:col-span-3 font-semibold text-slate-800"
          >Programming Languages:</span
        >
        <span class="sm:col-span-9 text-slate-700">
          Rust, Go, TypeScript, JavaScript, Python, SQL, Bash, Java, C#, PHP
        </span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
        <span class="sm:col-span-3 font-semibold text-slate-800"
          >Backend & Systems:</span
        >
        <span class="sm:col-span-9 text-slate-700">
          Rust (Actix, Axum), Go (Gin, Gorm), Spring Boot, Node.js, REST APIs
        </span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
        <span class="sm:col-span-3 font-semibold text-slate-800"
          >Frontend & UI:</span
        >
        <span class="sm:col-span-9 text-slate-700">
          React, Next.js, Vue.js, Nuxt.js, Svelte, React Native, Bootstrap 5,
          TailwindCSS, PrimeFaces
        </span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
        <span class="sm:col-span-3 font-semibold text-slate-800"
          >Databases & Storage:</span
        >
        <span class="sm:col-span-9 text-slate-700">
          PostgreSQL, MySQL, SQLite, S3-Object Storage
        </span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
        <span class="sm:col-span-3 font-semibold text-slate-800"
          >DevOps & Cloud:</span
        >
        <span class="sm:col-span-9 text-slate-700">
          Docker, Terraform, Ansible, Linux Server Administration, GCP,
          DigitalOcean, Cloudflare, Git
        </span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
        <span class="sm:col-span-3 font-semibold text-slate-800"
          >Testing & Tools:</span
        >
        <span class="sm:col-span-9 text-slate-700">Playwright, Selenium</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
        <span class="sm:col-span-3 font-semibold text-slate-800">Others:</span>
        <span class="sm:col-span-9 text-slate-700"
          >Stripe API, Unity (Mirror Networking)</span
        >
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
        <span class="sm:col-span-3 font-semibold text-slate-800"
          >Spoken Languages:</span
        >
        <span class="sm:col-span-9 text-slate-700">
          Thai (Native), English (TOEIC: 775 — Listening: 445, Reading: 330, tested on 2023)
        </span>
      </div>
    </div>
  </section>
