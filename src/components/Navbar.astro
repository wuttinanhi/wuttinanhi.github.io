---
import "../styles/global.css";

const navLinks = [
  { label: "Home", href: "/" },
  { label: "Projects", href: "/projects" },
  { label: "Blog", href: "https://thedreambook.github.io" },
  { label: "CV/Resume", href: "/cv" },
];
---

 <!-- Navigation Header -->
    <header
      class="sticky top-0 z-40 w-full border-b border-cyan-900/30 bg-[#07090e]/85 backdrop-blur-md"
    >
      <div
        class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4"
      >
        <!-- Terminal Brand Prompt -->
        <a
          href="#home"
          class="group flex items-center gap-2 text-sm text-cyan-400 hover:text-cyan-300"
        >
          <span
            class="inline-block h-2 w-2 animate-ping rounded-full bg-cyan-400"
          ></span>
            &nbsp;
          <span class="text-slate-500">WELCOME</span>
           <!-- <span class="font-semibold text-slate-200 group-hover:text-cyan-300">master$</span> -->
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden items-center gap-8 md:flex">
          {
            navLinks.map((link) =>
             (
                <a
                  href={link.href}
                  class="text-xs tracking-wider text-slate-400 transition-colors hover:text-cyan-300"
                >
                  {link.label}
                </a>
              )
            )
          }
        </nav>

        <!-- Right Side HUD Controls (Warp Speed & Sound) -->
        <div class="hidden items-center gap-3 lg:flex">
          <!--  <button
            id="warp-btn"
            class="flex items-center gap-1.5 rounded border border-slate-800 bg-slate-900/80 px-2.5 py-1 text-[11px] text-slate-400 transition hover:border-cyan-500/50 hover:text-cyan-300"
            title="Toggle Warp Speed"
          >
            <span class="text-amber-400">⚡</span>
            <span
              >WARP: <strong id="warp-label" class="text-slate-300">OFF</strong
              ></span
            >
          </button>  -->

          <a
            href="https://demo-launcher-1.wuttinanwork.workers.dev"
            target="_blank"
          >
            <div
              class="flex items-center gap-2 border-slate-800 pl-3 text-[12px] text-slate-500"
            >
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500"
              ></span>
              <span>DEMO LAUNCHER</span>
            </div>
          </a>
        </div>

        <!-- Mobile Drawer Toggle -->
        <button
          id="mobile-menu-btn"
          aria-label="Toggle Menu"
          class="flex flex-col gap-1 md:hidden text-slate-300 hover:text-cyan-400"
        >
          <span class="h-0.5 w-6 bg-current transition-all"></span>
          <span class="h-0.5 w-6 bg-current transition-all"></span>
          <span class="h-0.5 w-6 bg-current transition-all"></span>
        </button>
      </div>

      <!-- Mobile Dropdown Navigation -->
      <div
        id="mobile-menu"
        class="hidden border-b border-cyan-950 bg-[#090d15] px-6 py-4 md:hidden"
      >
        <div class="flex flex-col gap-4 text-xs">
          {
            navLinks.map((link) =>
              (
                <a href={link.href} class="text-slate-400 hover:text-cyan-300">
                  {link.label}
                </a>
              )
            )
          }
        </div>
      </div>
    </header>

