---
import "../styles/global.css";
import rawCvData from "../data/cv.json";

type ShowOption = "cv" | "resume" | "both";
type DocumentMode = "cv" | "resume";

interface LinkItem {
  label: string;
  url: string;
}

interface SkillItem {
  label: string;
  items: string;
  show?: ShowOption;
}

interface HighlightItem {
  text: string;
  show?: ShowOption;
}

interface ExperienceItem {
  role: string;
  company: string;
  location: string;
  period: string;
  show?: ShowOption;
  highlights: HighlightItem[];
}

interface ProjectItem {
  name: string;
  badge?: string;
  category: "systems" | "fullstack" | string;
  stack: string;
  link: string;
  linkText: string;
  description: string;
  show?: ShowOption;
}

interface EducationItem {
  degree: string;
  institution: string;
  faculty: string;
  period: string;
  honors: string;
  show?: ShowOption;
}

interface CvData {
  profile: {
    name: string;
    title: string;
    subtitle: string;
    location: string;
    email: string;
    linkedin: LinkItem;
    github: LinkItem[];
    websites: LinkItem[];
  };
  summary: {
    show?: ShowOption;
    text: string;
  };
  skills: SkillItem[];
  experience: ExperienceItem[];
  projects: ProjectItem[];
  education: EducationItem[];
}

interface Props {
  mode?: DocumentMode;
}

const { mode = "cv" } = Astro.props;
const isResume = mode === "resume";
const data = rawCvData as CvData;

function shouldShow(show?: ShowOption): boolean {
  if (!show || show === "both") return true;
  return show === mode;
}

const showSummary = shouldShow(data.summary.show);
const visibleSkills = data.skills.filter((skill) => shouldShow(skill.show));
const visibleExperience = data.experience
  .filter((exp) => shouldShow(exp.show))
  .map((exp) => ({
    ...exp,
    highlights: exp.highlights.filter((h) => shouldShow(h.show)),
  }));
const visibleProjects = data.projects.filter((project) =>
  shouldShow(project.show),
);
const visibleEducation = data.education.filter((edu) => shouldShow(edu.show));

const projectSections = isResume
  ? [
      {
        title: "Selected Projects",
        items: visibleProjects,
      },
    ].filter((section) => section.items.length > 0)
  : [
      {
        title: "Systems, DevOps & Developer Tools",
        items: visibleProjects.filter((p) => p.category === "systems"),
      },
      {
        title: "Full-Stack Applications",
        items: visibleProjects.filter((p) => p.category === "fullstack"),
      },
      {
        title: "Other Projects",
        items: visibleProjects.filter(
          (p) => p.category !== "systems" && p.category !== "fullstack",
        ),
      },
    ].filter((section) => section.items.length > 0);

const iconSize = isResume ? "w-3 h-3" : "w-3.5 h-3.5";
const contactGap = isResume ? "gap-1" : "gap-1.5";
const sectionMargin = isResume ? "mb-2 print:mb-1" : "mb-5";
const sectionHeadingClass = isResume
  ? "text-[10.5px] uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200 pb-0.5 mb-1"
  : "text-xs uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200 pb-1 mb-2.5";
---

<!-- Main Document Paper Sheet -->
<main
  class:list={[
    "cv-page-container max-w-[210mm] mx-auto bg-white text-slate-800",
    isResume
      ? "my-0 sm:my-3 p-3.5 sm:p-6 print:p-0"
      : "my-0 sm:my-8 p-6 sm:p-12",
  ]}
>
  <!-- HEADER / PROFILE -->
  <section
    class:list={[
      isResume ? "mb-2 print:mb-1" : "border-slate-200 pb-5 mb-5",
    ]}
  >
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0 flex-1">
        <h1
          class:list={[
            "font-extrabold tracking-tight text-slate-900 uppercase",
            isResume ? "text-xl sm:text-2xl leading-none" : "text-2xl sm:text-3xl",
          ]}
        >
          {data.profile.name}
        </h1>
        <p
          class:list={[
            "font-semibold text-slate-700",
            isResume ? "text-xs sm:text-sm mt-0.5" : "text-sm sm:text-base mt-1",
          ]}
        >
          {data.profile.title}{" "}
          <span class="text-slate-500 font-normal">{data.profile.subtitle}</span>
        </p>

        <!-- Contact Links Grid -->
        <div
          class:list={[
            "flex flex-wrap text-slate-600",
            isResume
              ? "mt-1 gap-x-3 gap-y-0.5 text-[10.5px]"
              : "mt-3 gap-x-4 gap-y-1.5 text-xs",
          ]}
        >
          <span class:list={["inline-flex items-center", contactGap]}>
            <svg
              class:list={[iconSize, "text-slate-400 no-print shrink-0"]}
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
              ></path>
            </svg>
            {data.profile.location}
          </span>

          <span class:list={["inline-flex items-center", contactGap]}>
            <svg
              class:list={[iconSize, "text-slate-400 no-print shrink-0"]}
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <a
              href={`mailto:${data.profile.email}`}
              class="hover:text-slate-900 underline underline-offset-2"
            >
              {data.profile.email}
            </a>
          </span>

          <span class:list={["inline-flex items-center", contactGap]}>
            <a
              href={data.profile.linkedin.url}
              target="_blank"
              rel="noreferrer"
              class="hover:text-slate-900 underline underline-offset-2"
            >
              {data.profile.linkedin.label}
            </a>
          </span>

          <span class:list={["inline-flex items-center", contactGap]}>
            <span>GitHub:</span>
            {
              data.profile.github.map((account, index) => (
                <>
                  {index > 0 && <span class="text-slate-400">/</span>}
                  <a
                    href={account.url}
                    target="_blank"
                    rel="noreferrer"
                    class="hover:text-slate-900 underline underline-offset-2"
                  >
                    {account.label}
                  </a>
                </>
              ))
            }
          </span>

          <span
            class:list={[
              "inline-flex items-center whitespace-nowrap",
              contactGap,
            ]}
          >
            <svg
              class:list={[iconSize, "text-slate-400 no-print shrink-0"]}
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
              ></path>
            </svg>
            {
              data.profile.websites.map((site, index) => (
                <>
                  {index > 0 && <span class="text-slate-400">/</span>}
                  <a
                    href={site.url}
                    target="_blank"
                    rel="noreferrer"
                    class="hover:text-slate-900 underline underline-offset-2"
                  >
                    {site.label}
                  </a>
                </>
              ))
            }
          </span>

          <!-- Phone Number Input (no border & no color; icon appears on left when typed) -->
          <span
            class:list={[
              "cv-phone-wrapper inline-flex items-center print:hidden",
              contactGap,
            ]}
          >
            <svg
              class:list={[
                "cv-phone-icon hidden shrink-0 text-slate-400",
                iconSize,
              ]}
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            <input
              type="tel"
              aria-label="Phone number"
              title="Click to enter phone number"
              class="cv-phone-input bg-transparent border-0 outline-none focus:outline-none focus:ring-0 p-0 m-0 text-inherit w-28"
            />
          </span>
        </div>
      </div>

      <!-- Top-Right Profile Photo Box (300 × 384 aspect ratio, empty box no color) -->
      <label
        class:list={[
          "cv-photo-box shrink-0 block cursor-pointer overflow-hidden bg-transparent border-0 p-0",
          isResume ? "w-[20mm] h-[25.6mm]" : "w-[25mm] h-[32mm]",
        ]}
        title="Click to select profile photo"
      >
        <input
          type="file"
          accept="image/*"
          class="cv-photo-input hidden"
          aria-label="Upload profile photo"
        />
        <img
          src=""
          alt={data.profile.name}
          width="300"
          height="384"
          class="cv-photo-preview hidden w-full h-full object-cover"
        />
      </label>
    </div>
  </section>

  <!-- PROFESSIONAL SUMMARY -->
  {
    showSummary && (
      <section class:list={[sectionMargin, "print-break-inside-avoid"]}>
        <h2
          class:list={[
            isResume
              ? sectionHeadingClass
              : "text-xs uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200 pb-1 mb-2",
          ]}
        >
          Professional Summary
        </h2>
        <p
          class:list={[
            "leading-relaxed text-slate-700 [&_code]:font-mono [&_code]:text-slate-800 [&_code]:font-semibold [&_strong]:font-semibold [&_strong]:text-slate-900 [&_a]:underline [&_a:hover]:text-slate-900",
            isResume ? "text-[10.5px]" : "text-xs sm:text-[13px]",
          ]}
          set:html={data.summary.text}
        />
      </section>
    )
  }

  <!-- TECHNICAL SKILLS -->
  {
    visibleSkills.length > 0 && (
      <section class:list={[sectionMargin, "print-break-inside-avoid"]}>
        <h2 class={sectionHeadingClass}>Technical Skills</h2>
        <div
          class:list={[
            isResume ? "space-y-0.5 text-[10.5px] leading-tight" : "space-y-1.5 text-xs",
          ]}
        >
          {visibleSkills.map((skill) => (
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
              <span class="sm:col-span-3 font-semibold text-slate-800">
                {skill.label}:
              </span>
              <span class="sm:col-span-9 text-slate-700">{skill.items}</span>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- WORK EXPERIENCE -->
  {
    visibleExperience.length > 0 && (
      <section class={sectionMargin}>
        <h2
          class:list={[
            isResume
              ? sectionHeadingClass
              : "text-xs uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200 pb-1 mb-3",
          ]}
        >
          Work Experience
        </h2>

        {visibleExperience.map((exp, index) => (
          <article
            class:list={[
              "print-break-inside-avoid",
              index < visibleExperience.length - 1
                ? isResume
                  ? "mb-1.5 print:mb-1"
                  : "mb-4"
                : "",
            ]}
          >
            <div class="flex flex-wrap justify-between items-baseline gap-1">
              <h3
                class:list={[
                  "font-bold text-slate-900",
                  isResume ? "text-xs" : "text-xs sm:text-sm",
                ]}
              >
                {exp.role}
              </h3>
              <span
                class:list={[
                  "font-medium text-slate-500 font-mono",
                  isResume ? "text-[10.5px]" : "text-xs",
                ]}
              >
                {exp.period}
              </span>
            </div>
            <div
              class:list={[
                "font-semibold text-slate-700",
                isResume ? "text-[10.5px] mb-0.5" : "text-xs mb-1.5",
              ]}
            >
              {exp.company}{" "}
              <span class="font-normal text-slate-500">— {exp.location}</span>
            </div>
            <ul
              class:list={[
                "list-disc list-outside text-slate-700 [&_code]:font-mono [&_strong]:font-semibold [&_strong]:text-slate-900 [&_a]:underline [&_a:hover]:text-slate-900",
                isResume
                  ? "ml-3.5 space-y-0.5 text-[10.5px] leading-snug"
                  : "ml-4 space-y-1 text-xs leading-normal",
              ]}
            >
              {exp.highlights.map((highlight) => (
                <li set:html={highlight.text} />
              ))}
            </ul>
          </article>
        ))}
      </section>
    )
  }

  <!-- PROJECTS -->
  {
    projectSections.map((section) => (
      <section class={sectionMargin}>
        <h2
          class:list={[
            isResume
              ? sectionHeadingClass
              : "text-xs uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200 pb-1 mb-3",
          ]}
        >
          {section.title}
        </h2>

        <div class={isResume ? "space-y-1 print:space-y-0.5" : "space-y-3"}>
          {section.items.map((project) => (
            <div class="print-break-inside-avoid">
              <div class="flex flex-wrap justify-between items-baseline gap-1">
                <h3
                  class:list={[
                    "font-bold text-slate-900 inline-flex items-center gap-1.5",
                    isResume ? "text-xs" : "text-xs sm:text-sm",
                  ]}
                >
                  <span>{project.name}</span>
                  {project.badge && (
                    <span
                      class:list={[
                        "inline-block font-medium text-slate-600 bg-slate-100 border border-slate-200 rounded",
                        isResume
                          ? "px-1 py-0.5 text-[9px] leading-none"
                          : "px-1.5 py-0.5 text-[10px]",
                      ]}
                    >
                      {project.badge}
                    </span>
                  )}
                </h3>
                <a
                  href={project.link}
                  target="_blank"
                  rel="noreferrer"
                  class:list={[
                    "font-mono text-slate-500 hover:text-slate-800 underline",
                    isResume ? "text-[10px]" : "text-xs",
                  ]}
                >
                  {project.linkText}
                </a>
              </div>
              <p
                class:list={[
                  "font-mono mb-0.5",
                  isResume
                    ? "text-[10px] text-slate-500 leading-none"
                    : "text-[11px] text-slate-600",
                ]}
              >
                {project.stack}
              </p>
              <p
                class:list={[
                  "text-slate-700",
                  isResume
                    ? "text-[10.5px] leading-snug"
                    : "text-xs leading-normal",
                ]}
              >
                {project.description}
              </p>
            </div>
          ))}
        </div>
      </section>
    ))
  }

  <!-- EDUCATION -->
  {
    visibleEducation.length > 0 && (
      <section class="print-break-inside-avoid">
        <h2
          class:list={[
            isResume
              ? sectionHeadingClass
              : "text-xs uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200 pb-1 mb-2",
          ]}
        >
          Education
        </h2>
        <div class={isResume ? "space-y-1.5" : "space-y-3"}>
          {visibleEducation.map((edu) => (
            <div>
              <div class="flex flex-wrap justify-between items-baseline gap-1">
                <h3
                  class:list={[
                    "font-bold text-slate-900",
                    isResume ? "text-xs" : "text-xs sm:text-sm",
                  ]}
                >
                  {edu.degree}
                </h3>
                <span
                  class:list={[
                    "font-medium text-slate-500 font-mono",
                    isResume ? "text-[10.5px]" : "text-xs",
                  ]}
                >
                  {edu.period}
                </span>
              </div>
              <p
                class:list={[
                  "font-semibold text-slate-700 mt-0.5",
                  isResume ? "text-[10.5px]" : "text-xs",
                ]}
              >
                {edu.institution}{" "}
                <span class="font-normal text-slate-500">— {edu.faculty}</span>
              </p>
              {edu.honors && (
                <p
                  class:list={[
                    "text-slate-700",
                    isResume ? "text-[10.5px] mt-0.5" : "text-xs mt-1",
                  ]}
                >
                  <strong class="font-semibold text-slate-900">Honors:</strong>{" "}
                  {edu.honors}
                </p>
              )}
            </div>
          ))}
        </div>
      </section>
    )
  }
</main>

<script>
  const photoInputs =
    document.querySelectorAll<HTMLInputElement>(".cv-photo-input");
  const photoPreviews =
    document.querySelectorAll<HTMLImageElement>(".cv-photo-preview");

  photoInputs.forEach((input) => {
    input.addEventListener("change", () => {
      const file = input.files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = () => {
        const dataUrl = typeof reader.result === "string" ? reader.result : "";
        if (!dataUrl) return;
        photoPreviews.forEach((img) => {
          img.src = dataUrl;
          img.classList.remove("hidden");
        });
      };
      reader.readAsDataURL(file);
      input.value = "";
    });
  });

  const phoneInputs =
    document.querySelectorAll<HTMLInputElement>(".cv-phone-input");
  const phoneIcons = document.querySelectorAll<SVGElement>(".cv-phone-icon");
  const phoneWrappers =
    document.querySelectorAll<HTMLElement>(".cv-phone-wrapper");

  function syncPhone(value: string) {
    const hasValue = value.trim().length > 0;
    phoneInputs.forEach((el) => {
      if (el.value !== value) el.value = value;
      el.style.width = hasValue ? `${Math.max(value.length + 1, 10)}ch` : "";
    });
    phoneIcons.forEach((icon) => {
      icon.classList.toggle("hidden", !hasValue);
    });
    phoneWrappers.forEach((wrapper) => {
      wrapper.classList.toggle("print:hidden", !hasValue);
    });
  }

  phoneInputs.forEach((input) => {
    input.addEventListener("input", () => {
      syncPhone(input.value);
    });
  });
</script>
