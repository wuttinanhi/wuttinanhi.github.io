---
import "../styles/global.css";
import TechnicalSkills from "../cv/TechnicalSkills.astro";

interface Project {
  name: string;
  badge?: string;
  stack: string;
  link: string;
  linkText: string;
  description: string;
}

const projects: Project[] = [
  {
    name: "Fire Survival Game",
    badge: "2nd Prize Winner",
    stack: "Unity, C#, Mirror Networking",
    link: "https://youtu.be/jF_XaidROFE",
    linkText: "youtu.be/jF_XaidROFE",
    description:
      "Awarded 2nd Prize in a national competition organized by the Department of Disaster Prevention and Mitigation (DDPM) for creating a multiplayer 3D emergency evacuation simulation game.",
  },
  {
    name: "Crane — Declarative VPS Deployment CLI",
    stack: "Rust/Go, PostgreSQL, Linux Firewall, DNS APIs, TOML",
    link: "https://github.com/dreamoutbox/crane",
    linkText: "github.com/dreamoutbox/crane",
    description:
      "CLI tool to deploy applications directly to VPS servers from a single TOML file. setup PostgreSQL database, scheduled backups, Linux firewall, and domain DNS record.",
  },
  {
    name: "PgVisor — PostgreSQL Cluster Supervisor",
    stack: "Rust, PostgreSQL, Web Dashboard",
    link: "https://github.com/dreamoutbox/pgvisor",
    linkText: "github.com/dreamoutbox/pgvisor",
    description:
      "a lightweight PostgreSQL cluster setup and management supervisor in Rust featuring a user-friendly web dashboard for operational visibility.",
  },
  {
    name: "Docker Volume Backup Tool",
    stack: "Tools (Rust)",
    link: "https://github.com/dreamoutbox/docker-backup-tool-rs",
    linkText: "github.com/dreamoutbox/docker-backup-tool-rs",
    description:
      "Built a fast CLI utility in Rust for automating Docker volume and container state backups.",
  },
  {
    name: "Apartment Management ERP",
    stack: "Java, Spring Boot, Thymeleaf, SQLite, OpenPDF",
    link: "https://github.com/dreamoutbox/java-apartment-management-system",
    linkText: "github.com/dreamoutbox/java-apartment-management-system",
    description:
      "full-stack apartment management system with features for tenant management, billing, and PDF invoice generation.",
  },
  {
    name: "QR Restaurant Management System",
    stack: "Rust, PostgreSQL",
    link: "https://github.com/dreamoutbox/rust-restaurant-system",
    linkText: "github.com/dreamoutbox/rust-restaurant-system",
    description:
      "a restaurant ordering system, with customers scan table QR codes to place orders, real-time order management dashboards for waitstaff and kitchen.",
  },
  {
    name: "Go Point-of-Sale (POS) System",
    stack: "Go (Golang), SQLite",
    link: "https://github.com/dreamoutbox/go-pos",
    linkText: "github.com/dreamoutbox/go-pos",
    description:
      "Point-of-Sale system featuring real-time inventory tracking, stock management, and automated sales reporting.",
  },
  {
    name: "Theater Seat Booking System",
    stack: "Rust, PostgreSQL, Stripe API, Background Workers",
    link: "https://github.com/dreamoutbox/theater-seat-booking",
    linkText: "github.com/dreamoutbox/theater-seat-booking",
    description:
      "A seat booking theater website with real-time updates and payment processing.",
  },
];
---

<style is:global>
  /* Reduces top/bottom margins from 10mm to 5mm for single-page print fit */
  @page {
    size: A4 portrait;
    margin: 5mm 12mm;
  }
</style>

<!-- Main CV Paper Sheet -->
<main
  class="cv-page-container max-w-[210mm] mx-auto my-0 sm:my-3 bg-white p-3.5 sm:p-6 print:p-0 text-slate-800"
>
  <!-- HEADER / PROFILE -->
  <section class="mb-2 print:mb-1">
    <h1
      class="text-xl sm:text-2xl font-extrabold tracking-tight text-slate-900 uppercase leading-none"
    >
      Wuttinan Hanglim
    </h1>
    <p class="text-xs sm:text-sm font-semibold text-slate-700 mt-0.5">
      Full-Stack & Systems Software Engineer <span
        class="text-slate-500 font-normal">(Rust, Go, TypeScript & DevOps)</span
      >
    </p>

    <!-- Contact Links Grid -->
    <div
      class="mt-1 flex flex-wrap gap-x-3 gap-y-0.5 text-[10.5px] text-slate-600"
    >
      <span class="inline-flex items-center gap-1">
        <svg
          class="w-3 h-3 text-slate-400 no-print"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        Thonburi, Bangkok 10600, Thailand
      </span>

      <span class="inline-flex items-center gap-1">
        <svg
          class="w-3 h-3 text-slate-400 no-print"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
          ></path>
        </svg>
        <a
          href="mailto:wuttinanwork@gmail.com"
          class="hover:text-slate-900 underline underline-offset-2"
          >wuttinanwork@gmail.com</a
        >
      </span>

      <span class="inline-flex items-center gap-1">
        <a
          href="https://www.linkedin.com/in/wuttinanhanglim"
          target="_blank"
          rel="noreferrer"
          class="hover:text-slate-900 underline underline-offset-2"
          >linkedin.com/in/wuttinanhanglim</a
        >
      </span>

      <span class="inline-flex items-center gap-1">
        <span>GitHub:</span>
        <a
          href="https://github.com/dreamoutbox"
          target="_blank"
          rel="noreferrer"
          class="hover:text-slate-900 underline underline-offset-2"
          >dreamoutbox</a
        >
        <span class="text-slate-400">/</span>
        <a
          href="https://github.com/wuttinanhi"
          target="_blank"
          rel="noreferrer"
          class="hover:text-slate-900 underline underline-offset-2"
          >wuttinanhi</a
        >
      </span>

      <span class="inline-flex items-center gap-1">
        <svg
          class="w-3 h-3 text-slate-400 no-print"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
          ></path>
        </svg>
        <a
          href="https://thedreambook.github.io"
          target="_blank"
          rel="noreferrer"
          class="hover:text-slate-900 underline underline-offset-2"
          >thedreambook.github.io</a
        >
      </span>
    </div>
  </section>

  <!-- TECHNICAL SKILLS -->
  <section class="mb-2 print:mb-1 print-break-inside-avoid">
    <h2
      class="text-[10.5px] uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200 pb-0.5 mb-1"
    >
      Technical Skills
    </h2>
    <div class="space-y-0.5 text-[10.5px] leading-tight">
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
        <span class="sm:col-span-3 font-semibold text-slate-800"
          >Programming Languages:</span
        >
        <span class="sm:col-span-9 text-slate-700">
          Rust, Go, TypeScript, JavaScript, Python, SQL, Bash, Java, C#, PHP
        </span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
        <span class="sm:col-span-3 font-semibold text-slate-800"
          >Backend & Systems:</span
        >
        <span class="sm:col-span-9 text-slate-700">
          Rust (Actix, Axum), Go (Gin, Gorm), Spring Boot, Node.js, REST APIs
        </span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
        <span class="sm:col-span-3 font-semibold text-slate-800"
          >Frontend & UI:</span
        >
        <span class="sm:col-span-9 text-slate-700">
          React, Next.js, Vue.js, Nuxt.js, Svelte, React Native, Bootstrap 5,
          TailwindCSS, PrimeFaces
        </span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
        <span class="sm:col-span-3 font-semibold text-slate-800"
          >Databases & Storage:</span
        >
        <span class="sm:col-span-9 text-slate-700">
          PostgreSQL, MySQL, SQLite, S3-Object Storage
        </span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
        <span class="sm:col-span-3 font-semibold text-slate-800"
          >DevOps & Cloud:</span
        >
        <span class="sm:col-span-9 text-slate-700">
          Docker, Terraform, Ansible, Linux Server Administration, GCP,
          DigitalOcean, Cloudflare, Git
        </span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
        <span class="sm:col-span-3 font-semibold text-slate-800"
          >Testing & Tools:</span
        >
        <span class="sm:col-span-9 text-slate-700">Playwright, Selenium</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
        <span class="sm:col-span-3 font-semibold text-slate-800">Others:</span>
        <span class="sm:col-span-9 text-slate-700"
          >Stripe API, Unity (Mirror Networking)</span
        >
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
        <span class="sm:col-span-3 font-semibold text-slate-800"
          >Spoken Languages:</span
        >
        <span class="sm:col-span-9 text-slate-700">
          Thai (Native), English (TOEIC: 775 — Listening: 445, Reading: 330,
          tested on 2023)
        </span>
      </div>
    </div>
  </section>

  <!-- WORK EXPERIENCE -->
  <section class="mb-2 print:mb-1">
    <h2
      class="text-[10.5px] uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200 pb-0.5 mb-1"
    >
      Work Experience
    </h2>

    <!-- Role 1 -->
    <article class="mb-1.5 print:mb-1 print-break-inside-avoid">
      <div class="flex flex-wrap justify-between items-baseline gap-1">
        <h3 class="text-xs font-bold text-slate-900">
          Independent Software Engineer & Open-Source Contributor
        </h3>
        <span class="text-[10.5px] font-medium text-slate-500 font-mono"
          >May 2024 – Present</span
        >
      </div>
      <div class="text-[10.5px] font-semibold text-slate-700 mb-0.5">
        Self-Directed / Open Source <span class="font-normal text-slate-500"
          >— Bangkok, Thailand</span
        >
      </div>
      <ul
        class="list-disc list-outside ml-3.5 space-y-0.5 text-[10.5px] text-slate-700 leading-snug"
      >
        <li>
          <strong class="font-semibold text-slate-900"
            >Open-Source Contributions (<code class="font-mono"
              >deadpool-rs</code
            >):</strong
          >
          Contributed merged PRs to the <code class="font-mono">deadpool</code>
          Rust connection pool ecosystem, fixing DevContainer startup (<a
            href="https://github.com/deadpool-rs/deadpool/pull/477"
            target="_blank"
            rel="noreferrer"
            class="underline hover:text-slate-900">#477</a
          >) and exporting <code class="font-mono">QueueMode</code> in <code
            class="font-mono">managed_reexports</code
          > (<a
            href="https://github.com/deadpool-rs/deadpool/pull/478"
            target="_blank"
            rel="noreferrer"
            class="underline hover:text-slate-900">#478</a
          >).
        </li>
        <li>
          <strong class="font-semibold text-slate-900"
            >Infrastructure & DevOps Tooling:</strong
          >
          Architected systems tools in Rust and Go: declarative VPS deployment CLI (<code
            class="font-mono">crane</code
          >), PostgreSQL cluster supervisor (<code class="font-mono"
            >pgvisor</code
          >), and a sandboxed execution server with AWS Firecracker MicroVMs.
        </li>
        <li>
          <strong class="font-semibold text-slate-900"
            >Full-Stack System Architecture:</strong
          >
          Engineered transactional systems in Rust, Go, and Spring Boot, integrating Stripe
          payment lifecycles, background task workers, and QR-based ordering workflows.
        </li>
        <li>
          <strong class="font-semibold text-slate-900"
            >Technical Writing:</strong
          >
          Author and maintain <a
            href="https://thedreambook.github.io"
            target="_blank"
            rel="noreferrer"
            class="underline hover:text-slate-900 font-semibold"
            >The Dream Book</a
          >, documenting systems programming, backend design, and DevOps practices.
        </li>
      </ul>
    </article>

    <!-- Role 2 -->
    <article class="mb-1.5 print:mb-1 print-break-inside-avoid">
      <div class="flex flex-wrap justify-between items-baseline gap-1">
        <h3 class="text-xs font-bold text-slate-900">
          Software Developer & QA Tester Intern
        </h3>
        <span class="text-[10.5px] font-medium text-slate-500 font-mono"
          >Jan 2024 – Apr 2024</span
        >
      </div>
      <div class="text-[10.5px] font-semibold text-slate-700 mb-0.5">
        Summit Computer Co., Ltd. <span class="font-normal text-slate-500"
          >— Bangkok, Thailand</span
        >
      </div>
      <ul
        class="list-disc list-outside ml-3.5 space-y-0.5 text-[10.5px] text-slate-700 leading-snug"
      >
        <li>
          Executed manual and automated QA testing for a government web system using an internal Java and Selenium testing framework.
        </li>
        <li>
          Documented defects, verified test coverage, and cooperated with engineering teams to meet government specifications.
        </li>
        <li>
          Built a full-stack module using JavaServer Faces (JSF), PrimeFaces, and PostgreSQL under senior developer mentorship.
        </li>
      </ul>
    </article>

    <!-- Role 3 -->
    <article class="print-break-inside-avoid">
      <div class="flex flex-wrap justify-between items-baseline gap-1">
        <h3 class="text-xs font-bold text-slate-900">
          Web Developer & IT Support Intern
        </h3>
        <span class="text-[10.5px] font-medium text-slate-500 font-mono"
          >Apr 2023 – Jul 2023</span
        >
      </div>
      <div class="text-[10.5px] font-semibold text-slate-700 mb-0.5">
        Suan Dusit University <span class="font-normal text-slate-500"
          >— Bangkok, Thailand</span
        >
      </div>
      <ul
        class="list-disc list-outside ml-3.5 space-y-0.5 text-[10.5px] text-slate-700 leading-snug"
      >
        <li>
          Automated bulk staff directory updates for the university website by surveying faculty via Google Forms and generating HTML with Python.
        </li>
        <li>
          Assisted in redesigning the WordPress portal to improve navigation layout and mobile responsiveness.
        </li>
        <li>
          Provided hardware, network, and desktop OS troubleshooting across university faculty workstations.
        </li>
      </ul>
    </article>
  </section>

  <!-- SELECTED PROJECTS -->
  <section class="mb-2 print:mb-1">
    <h2
      class="text-[10.5px] uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200 pb-0.5 mb-1"
    >
      Selected Projects
    </h2>

    <div class="space-y-1 print:space-y-0.5">
      {
        projects.map((project) => (
          <div class="print-break-inside-avoid">
            <div class="flex flex-wrap justify-between items-baseline gap-1">
              <h3 class="text-xs font-bold text-slate-900 inline-flex items-center gap-1.5">
                <span>{project.name}</span>
                {project.badge && (
                  <span class="inline-block px-1 py-0.2 text-[9px] font-medium text-slate-600 bg-slate-100 border border-slate-200 rounded">
                    {project.badge}
                  </span>
                )}
              </h3>
              <a
                href={project.link}
                target="_blank"
                rel="noreferrer"
                class="text-[10px] font-mono text-slate-500 hover:text-slate-800 underline"
              >
                {project.linkText}
              </a>
            </div>
            <p class="text-[10px] font-mono text-slate-500 leading-none mb-0.5">
              {project.stack}
            </p>
            <p class="text-[10.5px] text-slate-700 leading-snug">
              {project.description}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- EDUCATION -->
  <section class="print-break-inside-avoid">
    <h2
      class="text-[10.5px] uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200 pb-0.5 mb-1"
    >
      Education
    </h2>
    <div class="flex flex-wrap justify-between items-baseline gap-1">
      <h3 class="text-xs font-bold text-slate-900">
        Bachelor of Technology in Information Technology
      </h3>
      <span class="text-[10.5px] font-medium text-slate-500 font-mono"
        >2021 – 2024</span
      >
    </div>
    <p class="text-[10.5px] font-semibold text-slate-700 mt-0.5">
      Suan Dusit University <span class="font-normal text-slate-500"
        >— Faculty of Science and Technology</span
      >
    </p>
    <p class="text-[10.5px] text-slate-700 mt-0.5">
      <strong class="font-semibold text-slate-900">Honors:</strong> First-Class Honors
      (GPA: 3.77 / 4.00)
    </p>
  </section>
</main>