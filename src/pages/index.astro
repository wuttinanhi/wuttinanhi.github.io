---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

// Page metadata & configuration
const title = "WUTTINAN HANGLIM";
const description = "WUTTINAN HANGLIM portfolio";

// { label: "// 04.resume", href: "#resume", isAction: true },
const techStack = [
  "Rust",
  "Go",
  "TypeScript",
  "JavaScript",
  "Python",
  "SQL",
  "Bash",
  "Java",
  "C#",
  "Docker",
  "PostgreSQL",
  "React",
  "Vue",
];
---

<!doctype html>
<html
  lang="en"
  class="scroll-smooth bg-[#07090e] text-slate-100 antialiased selection:bg-cyan-500/30 selection:text-cyan-200"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="relative min-h-screen overflow-x-hidden font-['Fira_Code',monospace]"
  >
    <!-- Real-time ASCII Canvas Space Background -->
    <canvas
      id="ascii-canvas"
      class="pointer-events-none fixed inset-0 z-0 h-full w-full opacity-70"
    ></canvas>

    <!-- Subtle CRT Scanline & Radial Vignette Overlay -->
    <div
      class="pointer-events-none fixed inset-0 z-[1] bg-[radial-gradient(ellipse_at_center,transparent_0%,rgba(7,9,14,0.75)_80%)]"
    >
    </div>
    <div
      class="pointer-events-none fixed inset-0 z-[1] bg-[linear-gradient(rgba(18,24,38,0)_50%,rgba(0,0,0,0.25)_50%)] bg-[length:100%_4px]"
    >
    </div>

    <Navbar />

    <!-- Main Content Container -->
    <main class="relative z-10 mx-auto max-w-6xl px-6 pt-16 pb-24">
      <!-- HERO SECTION -->
      <section id="home" class="flex min-h-[70vh] flex-col justify-center">
        <!-- Main Headline -->
        <h1
          class="text-4xl font-extrabold tracking-tight sm:text-6xl lg:text-7xl"
        >
          WUTTINAN HANGLIM
        </h1>

        <!-- Subtext -->
        <p
          class="mt-6 max-w-2xl text-sm leading-relaxed text-slate-400 sm:text-base"
        >
          A <strong class="text-slate-200">Software Engineer</strong> with strong
          expertise in backend systems,
          <br /><br />
          full-stack web development, and DevOps automation.
          <br />
          creator of multiple developer tools.
          <br /><br />
          Proficient across Rust, Go, TypeScript, Python, and Java,
          <br />
          with deep hands-on experience in Linux infrastructure, PostgreSQL, Docker,
          and Cloud.
        </p>

        <!-- Tech Stack Ticker -->
        <div class="mt-8 flex flex-wrap items-center gap-2">
          <span class="mr-2 text-xs text-slate-500">SKILLS:</span>
          {
            techStack.map((tech) => (
              <span class="rounded bg-slate-900/90 border border-slate-800/80 px-2.5 py-1 text-[11px] text-cyan-300/80">
                {tech}
              </span>
            ))
          }
        </div>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="/projects"
            class="group inline-flex items-center gap-2 rounded bg-cyan-400 px-5 py-2.5 text-xs font-semibold text-slate-950 shadow-[0_0_20px_rgba(34,211,238,0.35)] transition-all hover:bg-cyan-300 hover:shadow-[0_0_30px_rgba(34,211,238,0.6)]"
          >
            <span>Explore Work</span>
            <span class="transition-transform group-hover:translate-x-1">→</span
            >
          </a>

          <a
            href="https://github.com/dreamoutbox"
            target="_blank"
            id="hero-resume-trigger"
            class="inline-flex items-center gap-2 rounded border border-slate-700 bg-slate-900/60 px-5 py-2.5 text-xs font-medium text-slate-300 transition-all hover:border-cyan-500/50 hover:bg-slate-800/80 hover:text-cyan-300"
          >
            <span>GITHUB / DREAMOUTBOX</span>
          </a>

          <a
            href="https://github.com/wuttinanhi"
            target="_blank"
            id="hero-resume-trigger"
            class="inline-flex items-center gap-2 rounded border border-slate-700 bg-slate-900/60 px-5 py-2.5 text-xs font-medium text-slate-300 transition-all hover:border-cyan-500/50 hover:bg-slate-800/80 hover:text-cyan-300"
          >
            <span>GITHUB / WUTTINANHI</span>
          </a>

          <a
            href="/cv"
            target="_blank"
            id="hero-resume-trigger"
            class="inline-flex items-center gap-2 rounded border border-slate-700 bg-slate-900/60 px-5 py-2.5 text-xs font-medium text-slate-300 transition-all hover:border-cyan-500/50 hover:bg-slate-800/80 hover:text-cyan-300"
          >
            <span>CV / Resume</span>
            <!-- <span class="text-cyan-400">[⌕]</span> -->
          </a>

          <a
            href="mailto:wuttinanwork@gmail.com"
            id="hero-resume-trigger"
            class="inline-flex items-center gap-2 rounded border border-slate-700 bg-slate-900/60 px-5 py-2.5 text-xs font-medium text-slate-300 transition-all hover:border-cyan-500/50 hover:bg-slate-800/80 hover:text-cyan-300"
          >
            <span>MAIL</span>
          </a>
        </div>

        <!-- Live Telemetry Matrix Indicators -->
        <div
          class="mt-14 grid grid-cols-2 gap-4 border-t border-slate-800/80 pt-8 sm:grid-cols-4"
        >
          <div class="border-l-2 border-cyan-500/50 pl-3">
            <div class="text-[11px] text-slate-500">// EXPERIENCE</div>
            <div class="text-lg font-bold text-slate-200">2+ Years</div>
          </div>

          <!-- <div class="border-l-2 border-amber-500/50 pl-3">
            <div class="text-[11px] text-slate-500">// LATENCY_P99</div>
            <div class="text-lg font-bold text-slate-200">&lt; 14ms</div>
          </div> -->
        </div>
      </section>

      <!-- BLOG PLACEHOLDER SECTION -->
    </main>

    <!-- CLIENT SCRIPT (Astro automatically bundles this to the client) -->
    <script>
      // ==========================================
      // 1. Procedural ASCII Space Engine (Canvas)
      // ==========================================
      const canvas = document.getElementById(
        "ascii-canvas",
      ) as HTMLCanvasElement;
      const ctx = canvas.getContext("2d");

      if (ctx) {
        let width = (canvas.width = window.innerWidth);
        let height = (canvas.height = window.innerHeight);

        const CHAR_SET = [".", "·", "*", "+", "°", "✦", "x", "o"];
        const STAR_COUNT = 160;
        let isWarp = false;

        interface Star {
          x: number;
          y: number;
          z: number;
          char: string;
          opacity: number;
          speed: number;
        }

        const stars: Star[] = Array.from({ length: STAR_COUNT }, () => ({
          x: Math.random() * width,
          y: Math.random() * height,
          z: Math.random() * 2 + 0.5,
          char: CHAR_SET[Math.floor(Math.random() * CHAR_SET.length)],
          opacity: Math.random() * 0.7 + 0.2,
          speed: Math.random() * 0.4 + 0.1,
        }));

        // Detailed ASCII Saturn Planet Art
        const saturnAscii = [
          "           .---.           ",
          "      --=-( *o* )=-=--     ",
          "           '---'           ",
        ];

        window.addEventListener("resize", () => {
          width = canvas.width = window.innerWidth;
          height = canvas.height = window.innerHeight;
        });

        const warpBtn = document.getElementById("warp-btn");
        const warpLabel = document.getElementById("warp-label");

        warpBtn?.addEventListener("click", () => {
          isWarp = !isWarp;
          if (warpLabel) {
            warpLabel.innerText = isWarp ? "MAX" : "OFF";
            warpLabel.className = isWarp ? "text-cyan-400" : "text-slate-300";
          }
        });

        function render() {
          if (!ctx) return;
          ctx.clearRect(0, 0, width, height);
          ctx.font = '13px "Fira Code", monospace';

          // Render moving ASCII Starfield
          const currentSpeedMultiplier = isWarp ? 14 : 1;
          for (let i = 0; i < stars.length; i++) {
            const star = stars[i];
            star.y += star.speed * currentSpeedMultiplier;

            if (star.y > height) {
              star.y = 0;
              star.x = Math.random() * width;
            }

            ctx.fillStyle = `rgba(165, 243, 252, ${star.opacity})`;
            ctx.fillText(star.char, star.x, star.y);
          }

          // Render background ASCII Saturn in upper right
          ctx.fillStyle = "rgba(103, 232, 249, 0.25)";
          const planetStartX = Math.max(width - 320, 40);
          const planetStartY = 110;
          saturnAscii.forEach((line, index) => {
            ctx.fillText(line, planetStartX, planetStartY + index * 16);
          });

          requestAnimationFrame(render);
        }

        render();
      }

      // ==========================================
      // 2. Interactive Resume Modal Handling
      // ==========================================
      const modal = document.getElementById("resume-modal");
      const openBtn = document.getElementById("open-resume-btn");
      const openBtnMobile = document.getElementById("open-resume-btn-mobile");
      // const heroResumeTrigger = document.getElementById("hero-resume-trigger");
      const closeBtn = document.getElementById("close-modal-btn");

      const openModal = () => modal?.classList.remove("hidden"),
        modalClasses = modal?.classList.add("flex");
      const closeModal = () => {
        modal?.classList.add("hidden");
        modal?.classList.remove("flex");
      };

      //heroResumeTrigger
      [openBtn, openBtnMobile].forEach((btn) =>
        btn?.addEventListener("click", () => {
          modal?.classList.remove("hidden");
          modal?.classList.add("flex");
        }),
      );

      closeBtn?.addEventListener("click", closeModal);

      // Close modal on backdrop click or Escape key
      modal?.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });

      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !modal?.classList.contains("hidden")) {
          closeModal();
        }
      });

      // ==========================================
      // 3. Mobile Navigation & Utility Handlers
      // ==========================================
      const mobileBtn = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");

      mobileBtn?.addEventListener("click", () => {
        mobileMenu?.classList.toggle("hidden");
      });
    </script>
  </body>
</html>
