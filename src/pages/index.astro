---
import BaseHead from "../components/BaseHead.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

import "../styles/global.css";

import "../styles/print.css";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <div class="text-center mt-5 hide-on-print">
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=print"
      />

      <button
        class="px-10 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-300"
        onclick="window.print()"
      >
        <span class="material-symbols-outlined align-bottom"> print </span>

        Print this page
      </button>
    </div>

    <div>
      <aside class="sidebar left-sidebar"></aside>

      <div class="page-container">
        <main class="resume-content" id="a4-page">
          <h1 class="text-3xl text-blue-600">WUTTINAN HANGLIM</h1>

          <!-- <hr class="text-blue-600 mt-5" /> -->
          <br />

          <!-- START CONTACT -->
          <section>
            <h2 class="text-header">Contact</h2>

            <div>
              <p class="text-1-rem">
                Address: Bukkhalo, Thonburi, Bangkok (10600) Thailand
              </p>
              <p class="text-1-rem">E-mail: wuttinanwork@gmail.com</p>
              <p class="text-1-rem">
                GitHub: <a href="https://github.com/wuttinanhi" target="_blank">
                  github.com/wuttinanhi
                </a>
              </p>
            </div>
          </section>
          <!-- END CONTACT -->

          <!-- START SKILLS -->
          <section>
            <h2 class="text-header">Skills</h2>

            <div>
              <p class="text-1-rem">
                <span>Programming Languages:</span> Javascript, TypeScript, Python,
                SQL, C#, Java, PHP, Python, Go, Rust
              </p>
              <p class="text-1-rem">
                <span>Frameworks:</span> React, Vue, Svelt, NextJS, Nuxt, Bootstrap
              </p>
              <p class="text-1-rem">
                <span>Tools:</span>
                Git, Github, Docker, VSCode, Jetbrains IDE, Terraform, Ansible, Bash,
                Unity
              </p>
              <p class="text-1-rem">
                <span>Clouds:</span> Google Cloud Platform, DigitalOcean, CloudFlare
              </p>
              <p class="text-1-rem">
                <span>OS:</span> Windows, Debian-based Linux
              </p>
              <p class="text-1-rem">
                <span>Languages:</span> Thai, English (TOEIC Listening 445 Reading
                330 tested on 2023)
              </p>
            </div>
          </section>
          <!-- END SKILLS -->

          <!-- START EDUCATION -->
          <section>
            <h2 class="text-header">Education</h2>

            <p class="text-1-rem">
              Bachelor of Technology, Information of Technology. Suan Dusit
              University.
            </p>

            <p class="text-1">Faculty of Science and Technology. 2021-2024</p>

            <p class="text-1">(First-class honours) (GPA 3.77)</p>
          </section>
          <!-- END EDUCATION -->

          <!-- START EXPERIENCES -->
          <section>
            <h2 class="text-header">Experiences</h2>

            <div class="mt-1.5">
              <div class="text-blue-700">
                <p class="text-1-rem">
                  Intern Software Tester and Software Developer at Summit
                  Computer Co., Ltd.
                </p>

                <p class="text-1">16/01/2024 - 23/04/2024</p>
              </div>

              <ul>
                <li>
                  &nbsp;Testing on corporate product projects using internal
                  testing tools.
                </li>
                <li>
                  &nbsp;Documenting test results to track software quality.
                </li>
                <li>
                  &nbsp;Developing a Java JSF Website Project coaching by Senior
                  Software Engineer.
                </li>
              </ul>
            </div>

            <div class="mt-5">
              <div class="text-blue-700">
                <p class="text-1-rem">
                  Intern Web Development and IT Support at Suan Dusit University
                </p>

                <p class="text-1">1/4/2023 - 25/7/2023</p>
              </div>

              <ul>
                <li>
                  Updated and maintained the university's WordPress website.
                </li>
                <li>
                  Collaborated on implementing a new website design to improve
                  usability and visual appearance.
                </li>
                <li>
                  Provided IT support by diagnosing and repairing computers,
                  printers, and other devices.
                </li>
                <li>
                  Assisted with general office tasks and supported university
                  events.
                </li>
              </ul>
            </div>
          </section>
          <!-- END EXPERIENCES -->

          <!-- START PROJECTS -->
          <section>
            <h2 class="text-header">Projects</h2>

            <!-- list-disc -->
            <ul class="ul-li-space-more-y">
              <li>
                <a href="https://youtu.be/jF_XaidROFE" target="_blank">
                  Fire Survival Game - Multiplayer Unity game about escaping a
                  fire building (2nd Prize Winner).
                </a>
              </li>

              <li>
                <a
                  href="https://github.com/wuttinanhi/rust-forum"
                  target="_blank"
                >
                  Rust Forum - Forum web application written in Rust programming
                  language.
                </a>
              </li>

              <li>
                <a
                  href="https://github.com/wuttinanhi/nuxtshop"
                  target="_blank"
                >
                  Nuxtshop - Shopping website written in NuxtJS. with Stripe
                  payment integration.
                </a>
              </li>

              <li>
                <a href="https://thedreambook.github.io/blog" target="_blank">
                  thedreambook.github.io - software engineering knowledge web
                  blog.
                </a>
              </li>

              <li>
                <a
                  href="https://github.com/wuttinanhi/car-parking-reservation-2025"
                  target="_blank"
                >
                  Car Parking Reservation - Android App (React Native) for
                  parking lot reservation.
                </a>
              </li>

              <li>
                <a
                  href="https://drive.google.com/drive/folders/1kHR4F8TNpIwp2yKbeCx9eDPKXGF12QZZ?usp=sharing"
                  target="_blank"
                >
                  Image Classification Model for Plastic Garbage - Plastic type
                  classifier model using the YOLOv4 with CIRA CORE. (University
                  project)
                </a>
              </li>
            </ul>

            <!-- <div class="flex flex-col gap-y-1"></div> -->
          </section>
          <!-- END PROJECTS -->
        </main>
      </div>

      <aside class="sidebar right-sidebar"></aside>
    </div>
  </body>
</html>
