---
// src/pages/cv.astro (or src/pages/index.astro)
import "../styles/global.css";

const title = "Wuttinan Hanglim — CV / Resume";
const description =
  "Full-Stack & Systems Software Engineer CV (Rust, Go, TypeScript & DevOps)";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      body {
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          sans-serif;
        color: #1e293b;
      }
      .font-mono {
        font-family: "JetBrains Mono", monospace;
      }

      /* Base screen view background */
      @media screen {
        body {
          background-color: #f1f5f9;
        }
        .cv-page-container {
          box-shadow:
            0 4px 6px -1px rgb(0 0 0 / 0.1),
            0 2px 4px -2px rgb(0 0 0 / 0.1);
        }
      }

      /* Print & A4 Configuration */
      @page {
        size: A4 portrait;
        margin: 10mm 14mm;
      }

      @media print {
        *,
        *::before,
        *::after {
          box-shadow: none !important;
          text-shadow: none !important;
        }

        html,
        body {
          background: #ffffff !important;
          color: #0f172a !important;
          font-size: 9pt;
          line-height: 1.35;
          margin: 0 !important;
          padding: 0 !important;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        .no-print {
          display: none !important;
        }

        .cv-page-container {
          box-shadow: none !important;
          margin: 0 !important;
          padding: 0 !important;
          max-width: 100% !important;
          width: 100% !important;
          background: transparent !important;
        }

        .print-break-inside-avoid {
          break-inside: avoid;
          page-break-inside: avoid;
        }

        a {
          text-decoration: none !important;
          color: inherit !important;
        }
      }
    </style>
  </head>
  <body class="antialiased selection:bg-slate-200">
    <!-- Screen-only Floating Action Bar -->
    <header
      class="no-print sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200 py-3 px-4 shadow-xs"
    >
      <div
        class="max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-3"
      >
        <div class="flex items-center gap-2">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500"
          ></span>
          <span class="font-semibold text-slate-800 text-sm">CV Preview</span>
          <span
            class="text-xs px-2 py-0.5 rounded-sm bg-slate-100 text-slate-600 font-mono"
          ></span>
        </div>
        <div class="flex items-center gap-2">
          <button
            id="print-btn"
            type="button"
            class="cursor-pointer inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-xs font-semibold bg-slate-900 text-white hover:bg-slate-800 transition active:scale-95"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2m-12 0v4h12v-4M8 14h8"
              ></path>
            </svg>
            Print
          </button>
        </div>
      </div>
    </header>

    <!-- Main CV Paper Sheet -->
    <main
      class="cv-page-container max-w-[210mm] mx-auto my-0 sm:my-8 bg-white p-6 sm:p-12 text-slate-800"
    >
      <!-- HEADER / PROFILE -->
      <section class="border-b border-slate-200 pb-5 mb-5">
        <h1
          class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 uppercase"
        >
          Wuttinan Hanglim
        </h1>
        <p class="text-sm sm:text-base font-semibold text-slate-700 mt-1">
          Full-Stack & Systems Software Engineer <span
            class="text-slate-500 font-normal"
            >(Rust, Go, TypeScript & DevOps)</span
          >
        </p>

        <!-- Contact Links Grid -->
        <div
          class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5 text-xs text-slate-600"
        >
          <span class="inline-flex items-center gap-1.5">
            <svg
              class="w-3.5 h-3.5 text-slate-400 no-print"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
            >
            Thonburi, Bangkok 10600, Thailand
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg
              class="w-3.5 h-3.5 text-slate-400 no-print"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path></svg
            >
            <a
              href="mailto:wuttinanwork@gmail.com"
              class="hover:text-slate-900 underline underline-offset-2"
              >wuttinanwork@gmail.com</a
            >
          </span>
          <span class="inline-flex items-center gap-1.5">
            <a
              href="https://www.linkedin.com/in/wuttinanhanglim"
              target="_blank"
              rel="noreferrer"
              class="hover:text-slate-900 underline underline-offset-2"
              >linkedin.com/in/wuttinanhanglim</a
            >
          </span>
          <span class="inline-flex items-center gap-1.5">
            <span>GitHub:</span>
            <a
              href="https://github.com/dreamoutbox"
              target="_blank"
              rel="noreferrer"
              class="hover:text-slate-900 underline underline-offset-2"
              >dreamoutbox</a
            >
            <span class="text-slate-400"></span>
            <span class="text-slate-300">|</span>
            <a
              href="https://github.com/wuttinanhi"
              target="_blank"
              rel="noreferrer"
              class="hover:text-slate-900 underline underline-offset-2"
              >wuttinanhi</a
            >
            <span class="text-slate-400"></span>
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg
              class="w-3.5 h-3.5 text-slate-400 no-print"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
              ></path></svg
            >
            <a
              href="https://thedreambook.github.io"
              target="_blank"
              rel="noreferrer"
              class="hover:text-slate-900 underline underline-offset-2"
              >thedreambook.github.io</a
            >
          </span>
        </div>
      </section>

      <!-- PROFESSIONAL SUMMARY -->
      <section class="mb-5 print-break-inside-avoid">
        <h2
          class="text-xs uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200 pb-1 mb-2"
        >
          Professional Summary
        </h2>
        <p class="text-xs sm:text-[13px] leading-relaxed text-slate-700">
          Software Engineer with a First-Class Honors degree in Information
          Technology and strong expertise in backend systems, full-stack web
          development, and DevOps automation. open-source contributor to
          the Rust ecosystem (<code
            class="font-mono text-slate-800 font-semibold">deadpool-rs</code
          >) and creator of multiple production-grade developer tools, including
          a Firecracker MicroVM code execution server, an LLDB MCP server, and
          an automated VPS deployment CLI. Proficient across <strong
            class="font-semibold text-slate-900"
            >Rust, Go, TypeScript, Python, and Java (Spring Boot)</strong
          >, with deep hands-on experience in <strong
            class="font-semibold text-slate-900"
            >PostgreSQL, Docker, Linux infrastructure, and cloud administration</strong
          >.
        </p>
      </section>

      <!-- TECHNICAL SKILLS -->
      <section class="mb-5 print-break-inside-avoid">
        <h2
          class="text-xs uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200 pb-1 mb-2.5"
        >
          Technical Skills
        </h2>
        <div class="space-y-1.5 text-xs">
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
            <span class="sm:col-span-3 font-semibold text-slate-800"
              >Core Languages:</span
            >
            <span class="sm:col-span-9 text-slate-700"
              >Rust, Go (Golang), TypeScript, JavaScript, Python, SQL, Bash</span
            >
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
            <span class="sm:col-span-3 font-semibold text-slate-800"
              >Familiar Languages:</span
            >
            <span class="sm:col-span-9 text-slate-700">Java, C#</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
            <span class="sm:col-span-3 font-semibold text-slate-800"
              >Backend & Systems:</span
            >
            <span class="sm:col-span-9 text-slate-700"
              >Actix Web, Spring Boot, Node.js, AWS Firecracker MicroVM, Model
              Context Protocol (MCP), LLDB, REST APIs</span
            >
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
            <span class="sm:col-span-3 font-semibold text-slate-800"
              >Frontend & UI:</span
            >
            <span class="sm:col-span-9 text-slate-700"
              >React, Next.js, Vue.js, Nuxt.js, Svelte, HTMX, React Native,
              Bootstrap 5, PrimeFaces, Handlebars</span
            >
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
            <span class="sm:col-span-3 font-semibold text-slate-800"
              >Databases & Storage:</span
            >
            <span class="sm:col-span-9 text-slate-700"
              >PostgreSQL, SQLite, S3-Compatible Object Storage</span
            >
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
            <span class="sm:col-span-3 font-semibold text-slate-800"
              >DevOps & Cloud:</span
            >
            <span class="sm:col-span-9 text-slate-700"
              >Docker, Terraform, Ansible, Linux Server Administration
              (Debian/Ubuntu), Automated Firewall/DNS Configuration, GCP,
              DigitalOcean, Cloudflare, Git</span
            >
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
            <span class="sm:col-span-3 font-semibold text-slate-800"
              >Testing & Tools:</span
            >
            <span class="sm:col-span-9 text-slate-700"
              >Selenium, OpenPDF, Stripe API, Unity (Mirror Networking)</span
            >
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-1">
            <span class="sm:col-span-3 font-semibold text-slate-800"
              >Spoken Languages:</span
            >
            <span class="sm:col-span-9 text-slate-700"
              >
              Thai (Native), 
              English (TOEIC: 775 — Listening: 445, Reading: 330, tested on 2023)
            </span>
          </div>
        </div>
      </section>

      <!-- WORK EXPERIENCE -->
      <section class="mb-5">
        <h2
          class="text-xs uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200 pb-1 mb-3"
        >
          Work Experience
        </h2>

        <!-- Role 1 -->
        <article class="mb-4 print-break-inside-avoid">
          <div class="flex flex-wrap justify-between items-baseline gap-1">
            <h3 class="text-xs sm:text-sm font-bold text-slate-900">
              Independent Software Engineer & Open-Source Contributor
            </h3>
            <span class="text-xs font-medium text-slate-500 font-mono"
              >May 2024 – Present</span
            >
          </div>
          <div class="text-xs font-semibold text-slate-700 mb-1.5">
            Self-Directed / Open Source <span class="font-normal text-slate-500"
              >• Bangkok, Thailand</span
            >
          </div>
          <ul
            class="list-disc list-outside ml-4 space-y-1 text-xs text-slate-700 leading-normal"
          >
            <li>
              <strong class="font-semibold text-slate-900"
                >Open-Source Contributions (<code class="font-mono"
                  >deadpool-rs</code
                >):</strong
              > Contributed merged pull requests to the <code class="font-mono"
                >deadpool</code
              > Rust connection pool ecosystem, resolving DevContainer startup failures,
              optimizing Docker build caching via <code class="font-mono"
                >.dockerignore</code
              > and <code class="font-mono">postCreateCommand</code> restructuring
              (<a
                href="https://github.com/deadpool-rs/deadpool/pull/477"
                target="_blank"
                rel="noreferrer"
                class="underline hover:text-slate-900">#477</a
              >), and fixing macro visibility by exporting <code
                class="font-mono">QueueMode</code
              > in <code class="font-mono">managed_reexports</code> (<a
                href="https://github.com/deadpool-rs/deadpool/pull/478"
                target="_blank"
                rel="noreferrer"
                class="underline hover:text-slate-900">#478</a
              >).
            </li>
            <li>
              <strong class="font-semibold text-slate-900"
                >Infrastructure & DevOps Tooling:</strong
              > Architected and open-sourced multiple systems tools in Rust and Go,
              including a declarative TOML-based VPS deployment CLI (<code
                class="font-mono">crane</code
              >), a web-based PostgreSQL cluster supervisor (<code
                class="font-mono">pgvisor</code
              >), and a sandboxed code execution server powered by AWS
              Firecracker MicroVMs.
            </li>
            <li>
              <strong class="font-semibold text-slate-900"
                >Full-Stack System Architecture:</strong
              > Designed and built end-to-end transactional applications across Rust,
              Go, and Java Spring Boot, implementing background job workers, Stripe
              payment lifecycles (webhooks, refunds, cancellations), multi-role dashboards,
              and QR-based ordering workflows.
            </li>
            <li>
              <strong class="font-semibold text-slate-900"
                >Technical Writing:</strong
              > Author and maintain <a
                href="https://thedreambook.github.io"
                target="_blank"
                rel="noreferrer"
                class="underline hover:text-slate-900 font-semibold"
                >The Dream Book</a
              >, an open-access engineering blog documenting systems
              programming, backend architecture, and DevOps practices.
            </li>
          </ul>
        </article>

        <!-- Role 2 -->
        <article class="mb-4 print-break-inside-avoid">
          <div class="flex flex-wrap justify-between items-baseline gap-1">
            <h3 class="text-xs sm:text-sm font-bold text-slate-900">
              Software Developer & QA Tester Intern
            </h3>
            <span class="text-xs font-medium text-slate-500 font-mono"
              >Jan 2024 – Apr 2024</span
            >
          </div>
          <div class="text-xs font-semibold text-slate-700 mb-1.5">
            Summit Computer Co., Ltd. <span class="font-normal text-slate-500"
              >• Bangkok, Thailand</span
            >
          </div>
          <ul
            class="list-disc list-outside ml-4 space-y-1 text-xs text-slate-700 leading-normal"
          >
            <li>
              Executed manual and automated quality assurance testing for a
              large-scale government web system using an internal Java and
              Selenium testing framework.
            </li>
            <li>
              Documented software defects, tracked test coverage, and
              collaborated with engineering teams to ensure compliance with
              strict government project specifications.
            </li>
            <li>
              Built a full-stack web application module using JavaServer Faces
              (JSF), PrimeFaces, and PostgreSQL under the direct mentorship of a
              Senior Software Engineer.
            </li>
          </ul>
        </article>

        <!-- Role 3 -->
        <article class="print-break-inside-avoid">
          <div class="flex flex-wrap justify-between items-baseline gap-1">
            <h3 class="text-xs sm:text-sm font-bold text-slate-900">
              Web Developer & IT Support Intern
            </h3>
            <span class="text-xs font-medium text-slate-500 font-mono"
              >Apr 2023 – Jul 2023</span
            >
          </div>
          <div class="text-xs font-semibold text-slate-700 mb-1.5">
            Suan Dusit University <span class="font-normal text-slate-500"
              >• Bangkok, Thailand</span
            >
          </div>
          <ul
            class="list-disc list-outside ml-4 space-y-1 text-xs text-slate-700 leading-normal"
          >
            <li>
              Workflow Automation: Automated bulk directory updates for the
              university website by surveying faculty via Google Forms and
              writing a Python script to programmatically generate and deploy
              HTML content.
            </li>
            <li>
              Collaborated on redesigning the university's WordPress web portal
              to modernize the UI and improve navigation usability.
            </li>
            <li>
              Provided hardware, network, and software troubleshooting for
              faculty workstations, printers, and university-wide events.
            </li>
          </ul>
        </article>
      </section>

      <!-- SYSTEMS, DEVOPS & DEVELOPER TOOLS -->
      <section class="mb-5">
        <h2
          class="text-xs uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200 pb-1 mb-3"
        >
          Systems, DevOps & Developer Tools
        </h2>

        <div class="space-y-3">
          <div class="print-break-inside-avoid">
            <div class="flex flex-wrap justify-between items-baseline gap-1">
              <h3 class="text-xs sm:text-sm font-bold text-slate-900">
                Crane — Declarative VPS Deployment CLI
              </h3>
              <a
                href="https://github.com/dreamoutbox/crane"
                target="_blank"
                rel="noreferrer"
                class="text-xs font-mono text-slate-500 hover:text-slate-800 underline"
                >github.com/dreamoutbox/crane</a
              >
            </div>
            <p class="text-[11px] font-mono text-slate-600 mb-0.5">
              Rust/Go, PostgreSQL, Linux Firewall, DNS APIs, TOML
            </p>
            <p class="text-xs text-slate-700 leading-normal">
              Built a zero-hassle deployment CLI tool allowing developers to
              deploy applications directly to VPS servers from a single TOML
              configuration file. Automated PostgreSQL database provisioning,
              scheduled backups, Linux firewall configuration, and domain DNS
              record management.
            </p>
          </div>

          <div class="print-break-inside-avoid">
            <div class="flex flex-wrap justify-between items-baseline gap-1">
              <h3 class="text-xs sm:text-sm font-bold text-slate-900">
                Rust Playground Server (MicroVM Sandbox)
              </h3>
              <a
                href="https://github.com/dreamoutbox/rust-playground-server"
                target="_blank"
                rel="noreferrer"
                class="text-xs font-mono text-slate-500 hover:text-slate-800 underline"
                >github.com/dreamoutbox/rust-playground-server</a
              >
            </div>
            <p class="text-[11px] font-mono text-slate-600 mb-0.5">
              Rust, AWS Firecracker MicroVM, Linux Virtualization
            </p>
            <p class="text-xs text-slate-700 leading-normal">
              Engineered a secure remote code execution server for compiling and
              running untrusted Rust code inside isolated AWS Firecracker
              MicroVMs.
            </p>
          </div>

          <div class="print-break-inside-avoid">
            <div class="flex flex-wrap justify-between items-baseline gap-1">
              <h3 class="text-xs sm:text-sm font-bold text-slate-900">
                PgVisor — PostgreSQL Cluster Supervisor
              </h3>
              <a
                href="https://github.com/dreamoutbox/pgvisor"
                target="_blank"
                rel="noreferrer"
                class="text-xs font-mono text-slate-500 hover:text-slate-800 underline"
                >github.com/dreamoutbox/pgvisor</a
              >
            </div>
            <p class="text-[11px] font-mono text-slate-600 mb-0.5">
              Rust, PostgreSQL, Web Dashboard
            </p>
            <p class="text-xs text-slate-700 leading-normal">
              Developed a lightweight PostgreSQL cluster management and
              monitoring supervisor in Rust featuring a user-friendly web
              dashboard for operational visibility.
            </p>
          </div>

          <div class="print-break-inside-avoid">
            <div class="flex flex-wrap justify-between items-baseline gap-1">
              <h3 class="text-xs sm:text-sm font-bold text-slate-900">
                Rust LLDB MCP Server
              </h3>
              <a
                href="https://github.com/dreamoutbox/rust_lldb_mcp"
                target="_blank"
                rel="noreferrer"
                class="text-xs font-mono text-slate-500 hover:text-slate-800 underline"
                >github.com/dreamoutbox/rust_lldb_mcp</a
              >
            </div>
            <p class="text-[11px] font-mono text-slate-600 mb-0.5">
              Rust, LLDB, Model Context Protocol (MCP)
            </p>
            <p class="text-xs text-slate-700 leading-normal">
              Created a Model Context Protocol (MCP) server wrapping the LLDB
              debugger, enabling AI assistants and LLM agents to interactively
              inspect, debug, and analyze compiled binaries.
            </p>
          </div>

          <div class="print-break-inside-avoid">
            <div class="flex flex-wrap justify-between items-baseline gap-1">
              <h3 class="text-xs sm:text-sm font-bold text-slate-900">
                Crontext — Human Natural Language to CRON Library
              </h3>
              <a
                href="https://github.com/dreamoutbox/crontext"
                target="_blank"
                rel="noreferrer"
                class="text-xs font-mono text-slate-500 hover:text-slate-800 underline"
                >github.com/dreamoutbox/crontext</a
              >
            </div>
            <p class="text-[11px] font-mono text-slate-600 mb-0.5">
              Rust (Library Crate)
            </p>
            <p class="text-xs text-slate-700 leading-normal">
              Published a reusable Rust crate that parses human-readable
              schedule expressions into standard CRON syntax.
            </p>
          </div>

          <div class="print-break-inside-avoid">
            <div class="flex flex-wrap justify-between items-baseline gap-1">
              <h3 class="text-xs sm:text-sm font-bold text-slate-900">
                Docker Volume Backup Tool
              </h3>
              <a
                href="https://github.com/dreamoutbox/docker-backup-tool-rs"
                target="_blank"
                rel="noreferrer"
                class="text-xs font-mono text-slate-500 hover:text-slate-800 underline"
                >github.com/dreamoutbox/docker-backup-tool-rs</a
              >
            </div>
            <p class="text-[11px] font-mono text-slate-600 mb-0.5">
              Tools (Rust)
            </p>
            <p class="text-xs text-slate-700 leading-normal">
              Built a fast CLI utility in Rust for automating Docker volume and
              container state backups.
