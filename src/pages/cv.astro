---
import "../styles/global.css";
import CvOrResume from "../components/CvOrResume.astro";

const title = "Wuttinan Hanglim — CV / Resume";
const description =
  "Full-Stack & Systems Software Engineer CV (Rust, Go, TypeScript & DevOps)";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      body {
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          sans-serif;
        color: #1e293b;
      }
      .font-mono {
        font-family: "JetBrains Mono", monospace;
      }

      /* Base screen view background */
      @media screen {
        body {
          background-color: #f1f5f9;
        }
        .cv-page-container {
          box-shadow:
            0 4px 6px -1px rgb(0 0 0 / 0.1),
            0 2px 4px -2px rgb(0 0 0 / 0.1);
        }
      }

      /* Print & A4 Configuration */
      @page {
        size: A4 portrait;
        margin: 10mm 14mm;
      }

      @media print {
        *,
        *::before,
        *::after {
          box-shadow: none !important;
          text-shadow: none !important;
        }

        html,
        body {
          background: #ffffff !important;
          color: #0f172a !important;
          font-size: 9pt;
          line-height: 1.35;
          margin: 0 !important;
          padding: 0 !important;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        .no-print {
          display: none !important;
        }

        .cv-page-container {
          box-shadow: none !important;
          margin: 0 !important;
          padding: 0 !important;
          max-width: 100% !important;
          width: 100% !important;
          background: transparent !important;
        }

        .print-break-inside-avoid {
          break-inside: avoid;
          page-break-inside: avoid;
        }

        a {
          text-decoration: none !important;
          color: inherit !important;
        }
      }
    </style>
  </head>
  <body class="antialiased selection:bg-slate-200">
    <CvOrResume />
  </body>
</html>
