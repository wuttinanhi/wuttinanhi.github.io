---

<!doctype html>
<html lang="en" class="scroll-smooth bg-[#07090e] text-slate-100 antialiased selection:bg-cyan-500/30 selection:text-cyan-200">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="relative min-h-screen overflow-x-hidden font-['Fira_Code',monospace]">
    
    <!-- Real-time ASCII Canvas Space Background -->
    <canvas id="ascii-canvas" class="pointer-events-none fixed inset-0 z-0 h-full w-full opacity-65"></canvas>
    
    <!-- CRT Vignette & Subtle Scanline Grids -->
    <div class="pointer-events-none fixed inset-0 z-[1] bg-[radial-gradient(ellipse_at_center,transparent_0%,rgba(7,9,14,0.8)_85%)]"></div>
    <div class="pointer-events-none fixed inset-0 z-[1] bg-[linear-gradient(rgba(18,24,38,0)_50%,rgba(0,0,0,0.25)_50%)] bg-[length:100%_4px]"></div>

    <Navbar/>

    <!-- Main Content -->
    <main class="relative z-10 mx-auto max-w-6xl px-6 pt-12 pb-24">
      
      <!-- Page Header & Filter HUD -->
      <section class="border-b border-slate-800/80 pb-8">
        <!-- <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-950/30 px-3 py-1 text-xs text-cyan-400">
          <span>●</span>
          <span>SYSTEM_CATALOG // REPOSITORIES & ARCHITECTURES</span>
        </div> -->

        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
          <div>
            <h1 class="text-3xl font-extrabold tracking-tight sm:text-5xl text-slate-100">
             <span class="bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-400 bg-clip-text text-transparent">Projects</span> 
            </h1>
            <p class="mt-3 max-w-2xl text-xs sm:text-sm text-slate-400 leading-relaxed">
              ---
            </p>
          </div>

          <!-- Dynamic Filter Controls -->
          <div class="flex items-center gap-2 p-1 rounded-lg border border-slate-800 bg-slate-950/70 backdrop-blur-sm">
            <button
              id="filter-all"
              class="filter-btn active-filter rounded px-3 py-1.5 text-xs font-medium text-slate-200 transition"
              data-filter="all"
            >
              ALL ({projects.length})
            </button>
            <button
              id="filter-systems"
              class="filter-btn rounded px-3 py-1.5 text-xs font-medium text-slate-400 hover:text-slate-200 transition"
              data-filter="systems"
            >
              TOOLS
            </button>
            <button
              id="filter-fullstack"
              class="filter-btn rounded px-3 py-1.5 text-xs font-medium text-slate-400 hover:text-slate-200 transition"
              data-filter="fullstack"
            >
              WEBAPP
            </button>
          </div>
        </div>
      </section>

      <!-- Projects Grid -->
      <section class="mt-10">
        <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {projects.map((project) => (
            <article
              class="project-card group relative flex flex-col justify-between rounded-lg border border-slate-800/90 bg-[#090d16]/75 p-6 backdrop-blur-sm transition-all duration-200 hover:border-cyan-500/50 hover:bg-[#0c121e]/90 hover:shadow-[0_0_25px_rgba(6,182,212,0.12)]"
              data-category={project.category}
            >
              <div>
                <!-- Top metadata row -->
                <div class="flex items-center justify-between gap-3 mb-3">
                  <div class="flex items-center gap-2 font-mono text-[11px]">
                    <!--  <span class="text-cyan-400 font-semibold">{project.category === "systems" ? "SYS_MODULE" : "WEB_APPLICATION"}</span> -->
                    {project.badge && (
                      <span class="rounded bg-cyan-950/60 border border-cyan-800/50 px-2 py-0.5 text-[10px] text-cyan-300">
                        {project.badge}
                      </span>
                    )}
                  </div>

                  {project.githubUrl && (
                    <a
                      href={project.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-1 text-[18px] font-mono text-slate-400 hover:text-cyan-300 transition-colors"
                      title="Open GitHub Repository"
                    >
                      <span>github</span>
                      <span class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
                    </a>
                  )}
                </div>

                <!-- Award Highlight if applicable -->
                {project.award && (
                  <div class="mb-3 inline-flex items-center gap-2 rounded border border-amber-500/40 bg-amber-950/30 px-2.5 py-1 text-[11px] text-amber-300">
                    <span>🏆</span>
                    <span class="font-semibold">{project.award}</span>
                  </div>
                )}

                <!-- Title & Tagline -->
                <h2 class="text-lg font-bold text-slate-100 group-hover:text-cyan-300 transition-colors">
                  {project.title}
                </h2>
                <div class="text-xs text-cyan-500/90 font-mono mt-0.5">
                  &gt; {project.tagline}
                </div>

                <!-- Bullet descriptions -->
                <ul class="mt-4 space-y-2 text-sm leading-relaxed text-slate-400">
                  {project.description.map((point) => (
                    <li class="flex items-start gap-2">
                      <span class="text-cyan-400/80 select-none mt-0.5">›</span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Tech Stack Tags at bottom -->
              <div class="mt-6 pt-4 border-t border-slate-800/60 flex flex-wrap gap-1.5">
                {project.techStack.map((tech) => (
                  <span class="rounded bg-slate-900 border border-slate-800 px-2 py-0.5 text-[10px] text-slate-400 group-hover:border-slate-700">
                    {tech}
                  </span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Bottom Terminal Command Prompt -->
      <section class="mt-16 rounded-lg border border-dashed border-slate-800 p-6 text-center text-xs text-slate-500 font-mono">
        <p>Looking for architecture breakdown?</p>
        <p class="mt-1 text-slate-400">
          Reach out via <a href="mailto:wuttinanwork@gmail.com" class="text-cyan-400 underline hover:text-cyan-300">wuttinanwork@gmail.com</a>.
        </p>
      </section>
    </main>

    <!-- Embedded Client Script -->
    <script>
      // ==========================================
      // 1. Procedural ASCII Space Engine
      // ==========================================
      const canvas = document.getElementById('ascii-canvas') as HTMLCanvasElement;
      const ctx = canvas?.getContext('2d');

      if (canvas && ctx) {
        let width = (canvas.width = window.innerWidth);
        let height = (canvas.height = window.innerHeight);

        const CHAR_SET = ['.', '·', '*', '+', '°', '✦', 'x'];
        const STAR_COUNT = 130;

        interface Star {
          x: number;
          y: number;
          char: string;
          opacity: number;
          speed: number;
        }

        const stars: Star[] = Array.from({ length: STAR_COUNT }, () => ({
          x: Math.random() * width,
          y: Math.random() * height,
          char: CHAR_SET[Math.floor(Math.random() * CHAR_SET.length)],
          opacity: Math.random() * 0.6 + 0.2,
          speed: Math.random() * 0.25 + 0.05,
        }));

        window.addEventListener('resize', () => {
          width = canvas.width = window.innerWidth;
          height = canvas.height = window.innerHeight;
        });

        function render() {
          if (!ctx) return;
          ctx.clearRect(0, 0, width, height);
          ctx.font = '12px "Fira Code", monospace';

          for (let i = 0; i < stars.length; i++) {
            const s = stars[i];
            s.y += s.speed;
            if (s.y > height) {
              s.y = 0;
              s.x = Math.random() * width;
            }
            ctx.fillStyle = `rgba(165, 243, 252, ${s.opacity})`;
            ctx.fillText(s.char, s.x, s.y);
          }

          requestAnimationFrame(render);
        }

        render();
      }

      // ==========================================
      // 2. Interactive Category Filter System
      // ==========================================
      const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
      const cards = document.querySelectorAll<HTMLElement>('.project-card');

      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const selected = btn.getAttribute('data-filter');

          // Update active styles
          filterButtons.forEach((b) => {
            b.classList.remove('bg-cyan-950/60', 'text-cyan-300', 'border', 'border-cyan-500/40');
            b.classList.add('text-slate-400');
          });

          btn.classList.remove('text-slate-400');
          btn.classList.add('bg-cyan-950/60', 'text-cyan-300', 'border', 'border-cyan-500/40');

          // Filter card visibility
          cards.forEach((card) => {
            const category = card.getAttribute('data-category');
            if (selected === 'all' || category === selected) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });

      // Default active styling on first button
      const defaultBtn = document.getElementById('filter-all');
      defaultBtn?.classList.add('bg-cyan-950/60', 'text-cyan-300', 'border', 'border-cyan-500/40');

      // ==========================================
      // 3. Mobile Navigation Menu
      // ==========================================
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      mobileBtn?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
